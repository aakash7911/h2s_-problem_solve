# EventWise AI Configuration
# Copy this file to .env to configure your local environment

# Server Port
PORT=3001

# AI Provider Configuration (Optional - Demo mode works out of the box without keys)
# Supported providers: gemini (default), openai
AI_PROVIDER=gemini

# Google Gemini API Key (get one from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Model overrides
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Server Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
